#BASIC COMMANDS:


#select * from 'table'                     : select all of the table

#select * from 'table' where id = x        : select all of the table where id = x



#delete from 'table' where id = x          : delete some part

#truncate table 'table' restart identity   : delete the table and reset ID



#drop table 'table'                         : delete the selected table

#drop table if exists 'table'               : exclude the table depends on contitional

#drop table if exists 'table' cascades      : exclude the table and all that depend on it   



#alter table 'table'
#add column 'column' TIMESTAMP              : add a column in your table




