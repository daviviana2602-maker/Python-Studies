### 💾 CRUD Concepts with SQLAlchemy ###
#1️⃣ Create / Insert

#new_record = TableName(product='Shoes', quantity=10, date=datetime.now())
#session.add(new_record)
#session.commit()

#session.add() → prepare new record

#session.commit() → actually insert into DB



#2️⃣ Read / Query

#item = session.query(TableName).filter_by(product='Shoes').first()

#first() → returns first result

#query() → start a search

#filter_by() → filter by column values

#all() → returns list of all results



#3️⃣ Update

#item.quantity = item.quantity + 5
