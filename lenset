quant = int(input('how many numbers do you want to insert: '))
nums = []
for i in range(quant):
    num = float(input(f'enter number: {i + 1}: '))
    nums.append(num)

unique = set(nums)

if len(unique) == 1:
    print('All numbers are the same')
elif len(unique) == quant:
    print('All numbers are different')
else:
    print('There are equal numbers, but not all')